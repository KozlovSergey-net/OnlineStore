@model RegisterViewModel
@{
    ViewData["Title"] = "Authontication";
}

<div>
    <form action="/authontication" method="post">
        <p>
            <label>Email</label>
            <input name="Email" type="text" value="@Model.Email" />
        </p>
        <p>
            <label>Пароль</label>
            <input name="Password" type="password" />
        </p>
        <button>Авторизоваться</button>
    </form>
</div>
